{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibePad",
  "version": "0.1.0",
  "identifier": "com.vibepad.app",
  "build": {
    "beforeDevCommand": "npm run build:apo && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:apo && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibePad",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../apo/target/release/vibepad_mic.dll": "vibepad_mic.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
